+	}{
+		{"top left", "\x1b[1;1R", 0, 0, 6, true},
+		{"two digit row", "\x1b[24;80R", 23, 79, 8, true},
+		{"trailing input is left alone", "\x1b[5;9Rabc", 4, 8, 6, true},
+		{"an arrow key is not a report", "\x1b[A", 0, 0, 0, false},
+		{"truncated", "\x1b[12;", 0, 0, 0, false},
+		{"missing terminator", "\x1b[12;34", 0, 0, 0, false},
+		{"not an escape", "12;34R", 0, 0, 0, false},
+		{"no digits", "\x1b[;R", 0, 0, 0, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			row, col, size, ok := parseCursorReport([]byte(tc.in))
+			if ok != tc.ok || (ok && (row != tc.row || col != tc.col || size != tc.size)) {
+				t.Errorf("parseCursorReport(%q) = (%d,%d,%d,%v), want (%d,%d,%d,%v)",
+					tc.in, row, col, size, ok, tc.row, tc.col, tc.size, tc.ok)
+			}
+		})
+	}
+}
+
+// A reply the shell asked for must reach the shell: claiming it would hang
+// reedline, which blocks waiting for its own answer.
+func TestConsumeCursorReportIgnoresRepliesWeDidNotRequest(t *testing.T) {
+	cprMu.Lock()
+	cprWaiting = nil
+	cprMu.Unlock()
+
+	if n := consumeCursorReport([]byte("\x1b[10;20R")); n != 0 {
+		t.Errorf("consumed %d bytes of a reply we never asked for", n)
+	}
+}
+
+func TestConsumeCursorReportClaimsOurOwnReply(t *testing.T) {
+	ch := make(chan int, 1)
+	cprMu.Lock()
+	cprWaiting = ch
+	cprMu.Unlock()
+	defer func() {
+		cprMu.Lock()
+		cprWaiting = nil
+		cprMu.Unlock()
+	}()
+
+	if n := consumeCursorReport([]byte("\x1b[10;20R")); n != 8 {
+		t.Fatalf("consumed %d bytes, want 8", n)
+	}
+	if row := <-ch; row != 9 {
+		t.Errorf("row = %d, want 9 (0-based)", row)
+	}
+}
diff --git a/root/escseq.go b/root/escseq.go
new file mode 100644
index 0000000..9e0a9d8
--- /dev/null
+++ b/root/escseq.go
@@ -0,0 +1,37 @@
+package root
+
+// escSeqEnd returns the index just past the escape sequence starting at start.
+//
+// The whole sequence has to reach the shell in a single write. Writing it a
+// byte at a time races the reader's escape-timeout disambiguation: reedline
+// sees a lone Esc, then a literal '[', then a literal 'A', and types "[A" into
+// the buffer instead of decoding an arrow key.
+//
+// The three shapes that matter:
+//
+//	ESC [ params final   CSI  — final is a letter or '~', params are digits/';'
+//	ESC O final          SS3  — application cursor mode, always three bytes
+//	ESC x                any other two-byte form (alt+key)
+//
+// SS3 needs its own case: scanning for "first letter" would stop on the 'O'
+// and truncate the sequence, dropping the byte that says which key it was.
+func escSeqEnd(input []byte, start int) int {
+	if start+1 >= len(input) {
+		return len(input)
+	}
+
+	switch input[start+1] {
+	case '[':
+		for j := start + 2; j < len(input); j++ {
+			c := input[j]
+			if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '~' {
+				return j + 1
+			}
+		}
+		return len(input)
+	case 'O':
+		return min(start+3, len(input))
+	default:
+		return start + 2
+	}
+}
