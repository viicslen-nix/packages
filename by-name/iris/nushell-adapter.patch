diff --git a/integration/shell/nu.go b/integration/shell/nu.go
new file mode 100644
index 0000000..f4b0265
--- /dev/null
+++ b/integration/shell/nu.go
@@ -0,0 +1,96 @@
+package shell
+
+import (
+	"fmt"
+	"maps"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// NuAdapter drives nushell. Unlike the zsh adapter there is no line-buffer
+// correction channel: reedline exposes no per-keystroke hook, so iris relies
+// entirely on its own keystroke-reconstructed buffer, the same way bash does.
+type NuAdapter struct{}
+
+func (n *NuAdapter) GetName() string      { return "nu" }
+func (n *NuAdapter) GetShellPath() string { return "nu" }
+
+func (n *NuAdapter) GetEnv(fd int, pid int) []string {
+	return append(os.Environ(), "IRIS_FD="+fmt.Sprint(fd), "IRIS_PID="+fmt.Sprint(pid))
+}
+
+// PrepareSelectSequence uses ctrl+u, which reedline binds to CutFromLineStart
+// with the same semantics readline and zle give it.
+func (n *NuAdapter) PrepareSelectSequence(selected string) []byte {
+	return append([]byte{0x15}, []byte(selected)...)
+}
+
+func (n *NuAdapter) ScanAliases() map[string]string {
+	dir := GetNuConfigDir()
+	return ScanNuAliases([]string{
+		filepath.Join(dir, "config.nu"),
+		filepath.Join(dir, "env.nu"),
+	})
+}
+
+func GetNuConfigDir() string {
+	if xdg := os.Getenv("XDG_CONFIG_HOME"); xdg != "" {
+		return filepath.Join(xdg, "nushell")
+	}
+	home, _ := os.UserHomeDir()
+	return filepath.Join(home, ".config", "nushell")
+}
+
+// GetNuHistoryFile returns nushell's plain-text history. Users on the sqlite
+// backend (history.sqlite3) get nothing here; atuin-history covers that case.
+func GetNuHistoryFile() string {
+	return filepath.Join(GetNuConfigDir(), "history.txt")
+}
+
+func ScanNuAliases(files []string) map[string]string {
+	aliases := make(map[string]string)
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return aliases
+	}
+
+	for _, f := range files {
+		path := f
+		if !filepath.IsAbs(f) {
+			path = filepath.Join(home, f)
+		}
+		data, err := os.ReadFile(path)
+		if err != nil {
+			continue
+		}
+
+		maps.Copy(aliases, ParseNuAliases(string(data)))
+	}
+	return aliases
+}
+
+// ParseNuAliases reads nushell's `alias name = command args` form. The POSIX
+// parser cannot handle it: the name is frequently quoted and `=` is its own
+// whitespace-delimited token rather than glued to the name.
+func ParseNuAliases(data string) map[string]string {
+	aliases := make(map[string]string)
+	for line := range strings.SplitSeq(data, "\n") {
+		line = strings.TrimSpace(line)
+		line = strings.TrimPrefix(line, "export ")
+		if !strings.HasPrefix(line, "alias ") {
+			continue
+		}
+		body := strings.TrimSpace(strings.TrimPrefix(line, "alias"))
+		name, val, ok := strings.Cut(body, "=")
+		if !ok {
+			continue
+		}
+		key := strings.Trim(strings.TrimSpace(name), "\"'`")
+		cmd := strings.TrimSpace(val)
+		if key != "" && cmd != "" {
+			aliases[key] = cmd
+		}
+	}
+	return aliases
+}
diff --git a/integration/shell/nu_test.go b/integration/shell/nu_test.go
new file mode 100644
index 0000000..6af41b7
--- /dev/null
+++ b/integration/shell/nu_test.go
@@ -0,0 +1,40 @@
+package shell
+
+import "testing"
+
+func TestParseNuAliases(t *testing.T) {
+	// the quoted-name, spaced-equals form home-manager and `alias` both emit
+	got := ParseNuAliases(`
+alias "art" = vendor/bin/sail artisan
+alias cat = bat
+export alias k = kubectl
+alias  spaced   =   dev-shell laravel
+# alias commented = nope
+alias broken
+not an alias line
+`)
+
+	want := map[string]string{
+		"art":    "vendor/bin/sail artisan",
+		"cat":    "bat",
+		"k":      "kubectl",
+		"spaced": "dev-shell laravel",
+	}
+
+	if len(got) != len(want) {
+		t.Fatalf("got %d aliases %v, want %d", len(got), got, len(want))
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Errorf("alias %q = %q, want %q", k, got[k], v)
+		}
+	}
+}
+
+// the posix parser must not silently half-parse nu syntax — that was the bug
+// that made a NuAdapter look like it worked while every alias went missing
+func TestPosixParserCannotReadNuAliases(t *testing.T) {
+	if got := ParseAliases(`alias "art" = vendor/bin/sail artisan`); len(got) != 0 {
+		t.Fatalf("posix parser unexpectedly parsed nu syntax: %v", got)
+	}
+}
