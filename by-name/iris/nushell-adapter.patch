+++ b/internal/config/keys_multi_test.go
@@ -0,0 +1,39 @@
+package config
+
+import "testing"
+
+// A binding must be reachable from every key it lists: atuin owns `up`, so the
+// overlay is navigated with ctrl+p/ctrl+n, but `down` should keep working too.
+func TestMatchKeyAcceptsAlternatives(t *testing.T) {
+	const binding = "down,ctrl+n"
+
+	for _, tc := range []struct {
+		name     string
+		input    []byte
+		want     bool
+		consumed int
+	}{
+		{"arrow down", []byte("\x1b[B"), true, 3},
+		{"application-mode arrow down", []byte("\x1bOB"), true, 3},
+		{"ctrl+n", []byte{0x0e}, true, 1},
+		{"unrelated key", []byte{0x0f}, false, 0},
+		{"arrow up is not in the list", []byte("\x1b[A"), false, 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, consumed := MatchKey(tc.input, binding)
+			if got != tc.want || consumed != tc.consumed {
+				t.Errorf("MatchKey(%q, %q) = (%v, %d), want (%v, %d)",
+					tc.input, binding, got, consumed, tc.want, tc.consumed)
+			}
+		})
+	}
+
+	// a single key must behave exactly as before
+	if got, consumed := MatchKey([]byte{0x0e}, "ctrl+n"); !got || consumed != 1 {
+		t.Errorf("single-key binding regressed: (%v, %d)", got, consumed)
+	}
+	// an empty alternative must not match everything
+	if got, _ := MatchKey([]byte{0x0e}, "down,"); got {
+		t.Error("trailing empty alternative should not match ctrl+n")
+	}
+}
diff --git a/root/cursorpos.go b/root/cursorpos.go
new file mode 100644
index 0000000..bf8d0c5
--- /dev/null
+++ b/root/cursorpos.go
@@ -0,0 +1,103 @@
+package root
+
+import (
+	"sync"
+	"time"
+
+	"github.com/versenilvis/iris/integration"
+)
+
+// The overlay needs the cursor's row to know whether it can draw below the
+// prompt. The only way to ask is DSR/CPR: write ESC [ 6 n and the terminal
+// answers ESC [ row ; col R -- on stdin, mixed in with whatever the user is
+// typing. The shell issues its own CPR requests too, and stealing one of those
+// answers would hang its line editor, so a reply is only consumed while a
+// request of ours is outstanding; anything else is forwarded untouched.
+var (
+	cprMu      sync.Mutex
+	cprWaiting chan int
+)
+
+// requestCursorRow asks where the cursor is and waits briefly for the answer.
+// Reports whether the row was learned; on failure the caller keeps whatever
+// placement it had, which degrades to drawing downwards.
+func requestCursorRow(write func([]byte), timeout time.Duration) bool {
+	ch := make(chan int, 1)
+
+	cprMu.Lock()
+	if cprWaiting != nil {
+		cprMu.Unlock()
+		return false // a request is already in flight
+	}
+	cprWaiting = ch
+	cprMu.Unlock()
+
+	defer func() {
+		cprMu.Lock()
+		cprWaiting = nil
+		cprMu.Unlock()
+	}()
+
+	write([]byte("\x1b[6n"))
+
+	select {
+	case row := <-ch:
+		integration.SetCursorRow(row)
+		return true
+	case <-time.After(timeout):
+		return false
+	}
+}
+
+// consumeCursorReport reports how many bytes of a CPR reply were consumed from
+// the head of input, and 0 when there is nothing of ours to take. A reply the
+// shell asked for must be forwarded, so this only claims one while a request
+// of ours is outstanding.
+func consumeCursorReport(input []byte) int {
+	cprMu.Lock()
+	ch := cprWaiting
+	cprMu.Unlock()
+	if ch == nil {
+		return 0
+	}
+
+	row, _, n, ok := parseCursorReport(input)
+	if !ok {
+		return 0
+	}
+
+	select {
+	case ch <- row:
+	default: // already answered; drop the duplicate rather than block
+	}
+	return n
+}
+
+// parseCursorReport decodes ESC [ <row> ; <col> R, returning 0-based
+// coordinates and the length of the sequence. Terminals report 1-based.
+func parseCursorReport(in []byte) (row, col, size int, ok bool) {
+	if len(in) < 6 || in[0] != 0x1b || in[1] != '[' {
+		return 0, 0, 0, false
+	}
+	i := 2
+	r := 0
+	digits := 0
+	for ; i < len(in) && in[i] >= '0' && in[i] <= '9'; i++ {
+		r = r*10 + int(in[i]-'0')
+		digits++
+	}
+	if digits == 0 || i >= len(in) || in[i] != ';' {
+		return 0, 0, 0, false
+	}
+	i++
+	c := 0
+	digits = 0
+	for ; i < len(in) && in[i] >= '0' && in[i] <= '9'; i++ {
+		c = c*10 + int(in[i]-'0')
+		digits++
+	}
+	if digits == 0 || i >= len(in) || in[i] != 'R' {
+		return 0, 0, 0, false
+	}
+	return r - 1, c - 1, i + 1, true
+}
