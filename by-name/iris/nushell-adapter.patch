@@ -0,0 +1,28 @@
+package root
+
+import "testing"
+
+func TestEscSeqEnd(t *testing.T) {
+	for _, tc := range []struct {
+		name  string
+		input string
+		start int
+		want  int
+	}{
+		{"arrow up", "\x1b[A", 0, 3},
+		{"arrow down", "\x1b[B", 0, 3},
+		{"application-mode arrow", "\x1bOA", 0, 3},
+		{"home key ends on tilde", "\x1b[1~", 0, 4},
+		{"modified arrow with params", "\x1b[1;5A", 0, 6},
+		{"stops at the first final byte", "\x1b[Axyz", 0, 3},
+		{"sequence later in the buffer", "ab\x1b[B", 2, 5},
+		{"unterminated runs to end", "\x1b[1;", 0, 4},
+		{"lone escape", "\x1b", 0, 1},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := escSeqEnd([]byte(tc.input), tc.start); got != tc.want {
+				t.Errorf("escSeqEnd(%q, %d) = %d, want %d", tc.input, tc.start, got, tc.want)
+			}
+		})
+	}
+}
