diff --git a/spec/system_nix_test.go b/spec/system_nix_test.go
new file mode 100644
index 0000000..c48cabc
--- /dev/null
+++ b/spec/system_nix_test.go
@@ -0,0 +1,32 @@
+package spec
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+// nix puts a hidden ".foo-wrapped" next to every wrapped program on PATH.
+// Before this filter they ranked as real commands, so an empty-buffer Up
+// pasted things like "..claude-wrapped.wrapbuddy" into the prompt.
+func TestScanPathSkipsHiddenNixWrappers(t *testing.T) {
+	dir := t.TempDir()
+	for _, name := range []string{"realcmd", ".realcmd-wrapped", "..claude-wrapped.wrapbuddy"} {
+		if err := os.WriteFile(filepath.Join(dir, name), []byte("#!/bin/sh\n"), 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	t.Setenv("PATH", dir)
+
+	pathCmds = make(map[string]bool)
+	scanPath()
+
+	if !pathCmds["realcmd"] {
+		t.Error("realcmd should be scanned")
+	}
+	for _, hidden := range []string{".realcmd-wrapped", "..claude-wrapped.wrapbuddy"} {
+		if pathCmds[hidden] {
+			t.Errorf("%q is a nix internal and must not be suggested", hidden)
+		}
+	}
+}
