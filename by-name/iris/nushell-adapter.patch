diff --git a/integration/shell/nu.go b/integration/shell/nu.go
new file mode 100644
index 0000000..f4b0265
--- /dev/null
+++ b/integration/shell/nu.go
@@ -0,0 +1,96 @@
+package shell
+
+import (
+	"fmt"
+	"maps"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// NuAdapter drives nushell. Unlike the zsh adapter there is no line-buffer
+// correction channel: reedline exposes no per-keystroke hook, so iris relies
+// entirely on its own keystroke-reconstructed buffer, the same way bash does.
+type NuAdapter struct{}
+
+func (n *NuAdapter) GetName() string      { return "nu" }
+func (n *NuAdapter) GetShellPath() string { return "nu" }
+
+func (n *NuAdapter) GetEnv(fd int, pid int) []string {
+	return append(os.Environ(), "IRIS_FD="+fmt.Sprint(fd), "IRIS_PID="+fmt.Sprint(pid))
+}
+
+// PrepareSelectSequence uses ctrl+u, which reedline binds to CutFromLineStart
+// with the same semantics readline and zle give it.
+func (n *NuAdapter) PrepareSelectSequence(selected string) []byte {
+	return append([]byte{0x15}, []byte(selected)...)
+}
+
+func (n *NuAdapter) ScanAliases() map[string]string {
+	dir := GetNuConfigDir()
+	return ScanNuAliases([]string{
+		filepath.Join(dir, "config.nu"),
+		filepath.Join(dir, "env.nu"),
+	})
+}
+
+func GetNuConfigDir() string {
+	if xdg := os.Getenv("XDG_CONFIG_HOME"); xdg != "" {
+		return filepath.Join(xdg, "nushell")
+	}
+	home, _ := os.UserHomeDir()
+	return filepath.Join(home, ".config", "nushell")
+}
+
+// GetNuHistoryFile returns nushell's plain-text history. Users on the sqlite
+// backend (history.sqlite3) get nothing here; atuin-history covers that case.
+func GetNuHistoryFile() string {
+	return filepath.Join(GetNuConfigDir(), "history.txt")
+}
+
+func ScanNuAliases(files []string) map[string]string {
+	aliases := make(map[string]string)
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return aliases
+	}
+
+	for _, f := range files {
+		path := f
+		if !filepath.IsAbs(f) {
+			path = filepath.Join(home, f)
+		}
+		data, err := os.ReadFile(path)
+		if err != nil {
+			continue
+		}
+
+		maps.Copy(aliases, ParseNuAliases(string(data)))
+	}
+	return aliases
+}
+
+// ParseNuAliases reads nushell's `alias name = command args` form. The POSIX
+// parser cannot handle it: the name is frequently quoted and `=` is its own
+// whitespace-delimited token rather than glued to the name.
+func ParseNuAliases(data string) map[string]string {
+	aliases := make(map[string]string)
+	for line := range strings.SplitSeq(data, "\n") {
+		line = strings.TrimSpace(line)
+		line = strings.TrimPrefix(line, "export ")
+		if !strings.HasPrefix(line, "alias ") {
+			continue
+		}
+		body := strings.TrimSpace(strings.TrimPrefix(line, "alias"))
+		name, val, ok := strings.Cut(body, "=")
+		if !ok {
+			continue
+		}
+		key := strings.Trim(strings.TrimSpace(name), "\"'`")
+		cmd := strings.TrimSpace(val)
+		if key != "" && cmd != "" {
+			aliases[key] = cmd
+		}
+	}
+	return aliases
+}
diff --git a/integration/shell/nu_test.go b/integration/shell/nu_test.go
new file mode 100644
index 0000000..6af41b7
--- /dev/null
+++ b/integration/shell/nu_test.go
@@ -0,0 +1,40 @@
+package shell
+
+import "testing"
+
+func TestParseNuAliases(t *testing.T) {
+	// the quoted-name, spaced-equals form home-manager and `alias` both emit
+	got := ParseNuAliases(`
+alias "art" = vendor/bin/sail artisan
+alias cat = bat
+export alias k = kubectl
+alias  spaced   =   dev-shell laravel
+# alias commented = nope
+alias broken
+not an alias line
+`)
+
+	want := map[string]string{
+		"art":    "vendor/bin/sail artisan",
+		"cat":    "bat",
+		"k":      "kubectl",
+		"spaced": "dev-shell laravel",
+	}
+
+	if len(got) != len(want) {
+		t.Fatalf("got %d aliases %v, want %d", len(got), got, len(want))
+	}
+	for k, v := range want {
+		if got[k] != v {
+			t.Errorf("alias %q = %q, want %q", k, got[k], v)
+		}
+	}
+}
+
+// the posix parser must not silently half-parse nu syntax — that was the bug
+// that made a NuAdapter look like it worked while every alias went missing
+func TestPosixParserCannotReadNuAliases(t *testing.T) {
+	if got := ParseAliases(`alias "art" = vendor/bin/sail artisan`); len(got) != 0 {
+		t.Fatalf("posix parser unexpectedly parsed nu syntax: %v", got)
+	}
+}
diff --git a/integration/viewport.go b/integration/viewport.go
new file mode 100644
index 0000000..29953e8
--- /dev/null
+++ b/integration/viewport.go
@@ -0,0 +1,84 @@
+package integration
+
+import (
+	"os"
+	"sync"
+
+	"golang.org/x/term"
+)
+
+// The overlay is drawn below the cursor, and only there. Making room by
+// printing newlines from here would scroll the viewport, and the shell's line
+// editor caches the prompt's absolute origin: reedline then repaints at the
+// stale row and leaves a copy of the prompt and the overlay behind on every
+// keystroke. Drawing above the cursor instead is worse -- those rows hold the
+// previous command's output, and painting over them destroys it.
+//
+// So the room is made before the prompt exists: the nushell pre_prompt hook
+// scrolls the viewport itself (see nuInitScript), which reedline then measures
+// as its origin. This file only has to fit the box into whatever room the
+// cursor ended up with.
+var (
+	viewportMu  sync.RWMutex
+	cursorRow   = -1 // 0-based row of the cursor; -1 when unknown
+	viewportSet bool
+)
+
+// SetCursorRow records where the cursor is. -1 marks it unknown, in which case
+// the overlay assumes it is safe to draw downwards.
+func SetCursorRow(row int) {
+	viewportMu.Lock()
+	defer viewportMu.Unlock()
+	cursorRow = row
+	viewportSet = row >= 0
+}
+
+// CursorRow returns the last measured cursor row, or -1.
+func CursorRow() int {
+	viewportMu.RLock()
+	defer viewportMu.RUnlock()
+	return cursorRow
+}
+
+func CursorRowKnown() bool {
+	viewportMu.RLock()
+	defer viewportMu.RUnlock()
+	return viewportSet
+}
+
+func getCursorRow() int {
+	viewportMu.RLock()
+	defer viewportMu.RUnlock()
+	return cursorRow
+}
+
+// termHeight returns the terminal height, falling back to 24 when the size
+// can't be determined (e.g. stdout isn't a TTY in tests).
+func termHeight() int {
+	_, h, err := term.GetSize(int(os.Stdout.Fd()))
+	if err != nil || h <= 0 {
+		return 24
+	}
+	return h
+}
+
+// planPlacement reports how many content rows of a `want`-row box actually fit
+// below the cursor. 0 means there is no room for a box at all.
+func planPlacement(want int) int {
+	return planPlacementFor(getCursorRow(), termHeight(), want)
+}
+
+// planPlacementFor is the arithmetic on its own, so it can be tested without a
+// terminal attached.
+func planPlacementFor(row, height, want int) int {
+	if row < 0 {
+		// Unknown position: keep the historical behaviour and assume room.
+		return want
+	}
+	below := height - 1 - row // rows strictly beneath the cursor
+	// Two of them go to the borders. A box with no content row is just noise.
+	if below-2 < 1 {
+		return 0
+	}
+	return min(want, below-2)
+}
diff --git a/integration/viewport_test.go b/integration/viewport_test.go
new file mode 100644
index 0000000..9334e67
--- /dev/null
+++ b/integration/viewport_test.go
@@ -0,0 +1,72 @@
+package integration
+
+import "testing"
+
+// A 24-row terminal, a box asking for `want` content rows plus two borders.
+// The box only ever goes below the cursor -- the rows above hold the previous
+// command's output -- so the only question is how much of it fits.
+func TestPlanPlacementFor(t *testing.T) {
+	const h = 24
+
+	for _, tc := range []struct {
+		name      string
+		row, want int
+		wantRows  int
+	}{
+		{
+			name: "unknown row assumes there is room",
+			row:  -1, want: 6,
+			wantRows: 6,
+		},
+		{
+			name: "room below",
+			row:  5, want: 6,
+			wantRows: 6,
+		},
+		{
+			name: "exactly enough room below",
+			row:  15, want: 6, // 24-1-15 = 8 = 6+2
+			wantRows: 6,
+		},
+		{
+			name: "one row short shrinks by one instead of flipping above",
+			row:  16, want: 6, // below = 7, so 5 content rows
+			wantRows: 5,
+		},
+		{
+			name: "three rows below leaves a one item box",
+			row:  20, want: 6,
+			wantRows: 1,
+		},
+		{
+			name: "two rows below is borders only, so nothing",
+			row:  21, want: 6,
+			wantRows: 0,
+		},
+		{
+			name: "last row draws nothing rather than painting upwards",
+			row:  23, want: 6,
+			wantRows: 0,
+		},
+		{
+			name: "asking for more than the screen holds shrinks to fit",
+			row:  3, want: 40, // below = 20
+			wantRows: 18,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got := planPlacementFor(tc.row, h, tc.want)
+			if got != tc.wantRows {
+				t.Errorf("planPlacementFor(row=%d, h=%d, want=%d) = %d, want %d",
+					tc.row, h, tc.want, got, tc.wantRows)
+			}
+			// whatever it decides, the box must fit below the cursor: drawing
+			// past the last row scrolls, and a scroll strands reedline's
+			// cached prompt origin.
+			if tc.row >= 0 && got > 0 && got+2 > h-1-tc.row {
+				t.Errorf("box of %d rows does not fit below row %d on a %d-row screen",
+					got+2, tc.row, h)
+			}
+		})
+	}
+}
