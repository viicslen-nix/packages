diff --git a/internal/config/keys_multi_test.go b/internal/config/keys_multi_test.go
new file mode 100644
index 0000000..f86af5b
--- /dev/null
+++ b/internal/config/keys_multi_test.go
@@ -0,0 +1,39 @@
+package config
+
+import "testing"
+
+// A binding must be reachable from every key it lists: atuin owns `up`, so the
+// overlay is navigated with ctrl+p/ctrl+n, but `down` should keep working too.
+func TestMatchKeyAcceptsAlternatives(t *testing.T) {
+	const binding = "down,ctrl+n"
+
+	for _, tc := range []struct {
+		name     string
+		input    []byte
+		want     bool
+		consumed int
+	}{
+		{"arrow down", []byte("\x1b[B"), true, 3},
+		{"application-mode arrow down", []byte("\x1bOB"), true, 3},
+		{"ctrl+n", []byte{0x0e}, true, 1},
+		{"unrelated key", []byte{0x0f}, false, 0},
+		{"arrow up is not in the list", []byte("\x1b[A"), false, 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, consumed := MatchKey(tc.input, binding)
+			if got != tc.want || consumed != tc.consumed {
+				t.Errorf("MatchKey(%q, %q) = (%v, %d), want (%v, %d)",
+					tc.input, binding, got, consumed, tc.want, tc.consumed)
+			}
+		})
+	}
+
+	// a single key must behave exactly as before
+	if got, consumed := MatchKey([]byte{0x0e}, "ctrl+n"); !got || consumed != 1 {
+		t.Errorf("single-key binding regressed: (%v, %d)", got, consumed)
+	}
+	// an empty alternative must not match everything
+	if got, _ := MatchKey([]byte{0x0e}, "down,"); got {
+		t.Error("trailing empty alternative should not match ctrl+n")
+	}
+}
diff --git a/root/escseq.go b/root/escseq.go
new file mode 100644
index 0000000..9e0a9d8
--- /dev/null
+++ b/root/escseq.go
@@ -0,0 +1,37 @@
+package root
+
+// escSeqEnd returns the index just past the escape sequence starting at start.
+//
+// The whole sequence has to reach the shell in a single write. Writing it a
+// byte at a time races the reader's escape-timeout disambiguation: reedline
+// sees a lone Esc, then a literal '[', then a literal 'A', and types "[A" into
+// the buffer instead of decoding an arrow key.
+//
+// The three shapes that matter:
+//
+//	ESC [ params final   CSI  — final is a letter or '~', params are digits/';'
+//	ESC O final          SS3  — application cursor mode, always three bytes
+//	ESC x                any other two-byte form (alt+key)
+//
+// SS3 needs its own case: scanning for "first letter" would stop on the 'O'
+// and truncate the sequence, dropping the byte that says which key it was.
+func escSeqEnd(input []byte, start int) int {
+	if start+1 >= len(input) {
+		return len(input)
+	}
+
+	switch input[start+1] {
+	case '[':
+		for j := start + 2; j < len(input); j++ {
+			c := input[j]
+			if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '~' {
+				return j + 1
+			}
+		}
+		return len(input)
+	case 'O':
+		return min(start+3, len(input))
+	default:
+		return start + 2
+	}
+}
