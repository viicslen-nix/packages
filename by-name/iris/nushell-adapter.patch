diff --git a/root/init_nu.go b/root/init_nu.go
new file mode 100644
index 0000000..862c00b
--- /dev/null
+++ b/root/init_nu.go
@@ -0,0 +1,81 @@
+package root
+
+// nuInitScript is nushell's autostart + IPC hook.
+//
+// Two things differ from the posix shells. Nushell has no `eval`, so the
+// script cannot be piped into the shell from the rc file — it has to be saved
+// and `source`d from a path known at parse time. And nushell cannot redirect
+// to a numbered fd, so the pipe iris passes as IRIS_FD is reached through
+// /proc/self/fd instead (Linux only; the posix hooks use >&$IRIS_FD).
+const nuInitScript = `
+# Iris Autostart Hook
+# a multiplexer pane inherits IRIS_* but runs on its own tty, so those vars
+# point at an iris that is not driving this terminal
+if "IRIS_PID" in $env {
+    let iris_ppid = (try { ^ps -o ppid= -p $nu.pid | str trim } catch { "" })
+    let iris_cur_tty = (try { ^tty | str trim } catch { "" })
+    if $env.IRIS_PID != $iris_ppid and $iris_cur_tty != ($env.IRIS_TTY? | default "") {
+        hide-env --ignore-errors IRIS_PID IRIS_IS_CHILD IRIS_FD IRIS_TTY
+    }
+}
+
+# nu is "interactive" whenever started without -c, even on a socket with no
+# tty, so the tty probe is the real guard; IRIS_IS_CHILD catches a re-exec'd child
+if $nu.is-interactive and ("IRIS_PID" not-in $env) and ("IRIS_IS_CHILD" not-in $env) and ("IRIS_RESCUE" not-in $env) and ((do -i { ^tty } | complete).exit_code == 0) {
+    if (which iris | is-not-empty) {
+        $env.IRIS_ACTIVE_SHELL = "nu"
+        exec iris
+    }
+}
+
+# The overlay is drawn below the prompt, and only there: the rows above hold
+# the previous command's output, and painting over them destroys it. At the
+# bottom of the screen there is no room below either, so make some here --
+# before the prompt is printed, which is the only safe moment. Reedline caches
+# the prompt's absolute origin, so anything that scrolls the viewport after it
+# has measured leaves a copy of the prompt behind on every keystroke; that is
+# why iris cannot do this itself from the outside.
+#
+# Costs a few blank rows under the prompt when it sits at the bottom of the
+# screen. Set IRIS_OVERLAY_ROWS=0 to keep the prompt on the last row instead
+# and let the box shrink to whatever fits (usually nothing).
+# Printing n newlines and stepping back up n always leaves exactly n rows
+# below the cursor, wherever it started: the terminal only scrolls for the
+# ones that ran past the last row, and it moves the cursor's own row up by
+# the same amount. So no cursor query is needed, and away from the bottom of
+# the screen this does nothing at all.
+def _iris_reserve [] {
+    let want = ($env.IRIS_OVERLAY_ROWS? | default "0" | into int)
+    if $want < 1 { return }
+    print -n $"(1..$want | each {|| "\n"} | str join)(ansi csi)($want)A"
+}
+
+# Iris Autocomplete Hook
+def _iris_send [msg: string] {
+    let fd = ($env.IRIS_FD? | default "")
+    if $fd != "" {
+        try { $"($msg)(char --integer 0)" | save --raw --append $"/proc/self/fd/($fd)" }
+    }
+}
+
+if ("IRIS_PID" in $env) and ("IRIS_FD" in $env) {
+    $env.config = ($env.config? | default {})
+    $env.config.hooks = ($env.config.hooks? | default {})
+    $env.config.hooks.pre_prompt = (
+        $env.config.hooks.pre_prompt?
+        | default []
+        | append {||
+            _iris_reserve
+            _iris_send $"IRIS_CWD:($env.PWD)"
+            _iris_send $"IRIS_CMD_STOP:($env.LAST_EXIT_CODE? | default 0)"
+        }
+    )
+    $env.config.hooks.pre_execution = (
+        $env.config.hooks.pre_execution?
+        | default []
+        | append {||
+            _iris_send "IRIS_CMD_START"
+        }
+    )
+}
+`
