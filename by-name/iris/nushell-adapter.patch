diff --git a/root/init_nu.go b/root/init_nu.go
new file mode 100644
index 0000000..858a5ab
--- /dev/null
+++ b/root/init_nu.go
@@ -0,0 +1,58 @@
+package root
+
+// nuInitScript is nushell's autostart + IPC hook.
+//
+// Two things differ from the posix shells. Nushell has no `eval`, so the
+// script cannot be piped into the shell from the rc file — it has to be saved
+// and `source`d from a path known at parse time. And nushell cannot redirect
+// to a numbered fd, so the pipe iris passes as IRIS_FD is reached through
+// /proc/self/fd instead (Linux only; the posix hooks use >&$IRIS_FD).
+const nuInitScript = `
+# Iris Autostart Hook
+# a multiplexer pane inherits IRIS_* but runs on its own tty, so those vars
+# point at an iris that is not driving this terminal
+if "IRIS_PID" in $env {
+    let iris_ppid = (try { ^ps -o ppid= -p $nu.pid | str trim } catch { "" })
+    let iris_cur_tty = (try { ^tty | str trim } catch { "" })
+    if $env.IRIS_PID != $iris_ppid and $iris_cur_tty != ($env.IRIS_TTY? | default "") {
+        hide-env --ignore-errors IRIS_PID IRIS_IS_CHILD IRIS_FD IRIS_TTY
+    }
+}
+
+# a non-interactive shell (tool runners sourcing config, scripts) has no prompt
+# to complete, and exec'ing here would seize the tty from the real iris
+if $nu.is-interactive and ("IRIS_PID" not-in $env) and ("IRIS_RESCUE" not-in $env) {
+    if (which iris | is-not-empty) {
+        $env.IRIS_ACTIVE_SHELL = "nu"
+        exec iris
+    }
+}
+
+# Iris Autocomplete Hook
+def _iris_send [msg: string] {
+    let fd = ($env.IRIS_FD? | default "")
+    if $fd != "" {
+        try { $"($msg)(char --integer 0)" | save --raw --append $"/proc/self/fd/($fd)" }
+    }
+}
+
+if ("IRIS_PID" in $env) and ("IRIS_FD" in $env) {
+    $env.config = ($env.config? | default {})
+    $env.config.hooks = ($env.config.hooks? | default {})
+    $env.config.hooks.pre_prompt = (
+        $env.config.hooks.pre_prompt?
+        | default []
+        | append {||
+            _iris_send $"IRIS_CWD:($env.PWD)"
+            _iris_send $"IRIS_CMD_STOP:($env.LAST_EXIT_CODE? | default 0)"
+        }
+    )
+    $env.config.hooks.pre_execution = (
+        $env.config.hooks.pre_execution?
+        | default []
+        | append {||
+            _iris_send "IRIS_CMD_START"
+        }
+    )
+}
+`
